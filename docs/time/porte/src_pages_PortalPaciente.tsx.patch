+type ClinicaPortal = {
+  nome: string;
+  cnpj?: string | null;
+  logoUrl: string | null;
+  endereco: string | null;
+  telefone: string | null;
+  celular: string | null;
+  email: string | null;
+};
+
+// sessionStorage morre ao fechar a aba: sobrevive ao recarregar sem deixar o
+// acesso salvo em computador compartilhado. localStorage só quando o paciente
+// marca "manter conectado" (app instalado no próprio celular).
+const SESSAO_PORTAL = 'elolab:portal-paciente';
+function salvarSessaoPortal(token: string | null) {
+  try {
+    if (token) {
+      sessionStorage.setItem(SESSAO_PORTAL, token);
+      if (localStorage.getItem(SESSAO_PORTAL)) localStorage.setItem(SESSAO_PORTAL, token);
+    } else {
+      sessionStorage.removeItem(SESSAO_PORTAL);
+      localStorage.removeItem(SESSAO_PORTAL);
+    }
+  } catch { /* navegação privada sem storage: segue só em memória */ }
+}
+function lerSessaoPortal(): string | null {
+  try { return sessionStorage.getItem(SESSAO_PORTAL) || localStorage.getItem(SESSAO_PORTAL); } catch { return null; }
+}
+function lembrarNesteAparelho(token: string | null) {
+  try {
+    if (token) localStorage.setItem(SESSAO_PORTAL, token);
+    else localStorage.removeItem(SESSAO_PORTAL);
+  } catch { /* sem storage: não há como lembrar */ }
+}
+function estaLembrado(): boolean {
+  try { return !!localStorage.getItem(SESSAO_PORTAL); } catch { return false; }
+}
+
+/** Troca o manifest enquanto o portal está aberto: instalar abre o portal, não o painel da equipe. */
+function useManifestDoPortal() {
+  useEffect(() => {
+    // O plugin PWA pode injetar um segundo <link rel="manifest">; troca todos.
+    const links = Array.from(document.querySelectorAll<HTMLLinkElement>('link[rel="manifest"]'));
+    const originais = links.map(link => link.href);
+    links.forEach(link => { link.href = '/portal-paciente.webmanifest'; });
+    return () => { links.forEach((link, i) => { link.href = originais[i]; }); };
+  }, []);
+}
+
+/** Dados da clínica para o cabeçalho dos PDFs gerados no portal (sem sessão). */
+function clinicaParaPdf(clinica: ClinicaPortal | null) {
+  return {
+    nome: clinica?.nome || '',
+    endereco: clinica?.endereco || '',
+    telefone: clinica?.telefone || clinica?.celular || '',
+    cnpj: clinica?.cnpj || '',
+    logoUrl: clinica?.logoUrl || undefined,
+  };
+}
+
+/** wa.me exige DDI; números brasileiros cadastrados sem 55 recebem o prefixo. */
+function whatsappDaClinica(clinica: ClinicaPortal | null): string | null {
+  const digitos = (clinica?.celular || clinica?.telefone || '').replace(/\D/g, '');
+  if (digitos.length < 10) return null;
+  return digitos.startsWith('55') && digitos.length > 11 ? digitos : `55${digitos}`;
+}
