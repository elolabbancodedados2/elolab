+function PreConsultaButton({ token, dependenteId, agendamentoId }: { token: string; dependenteId: string | null; agendamentoId: string }) {
+  const [open, setOpen] = useState(false);
+  const [respostas, setRespostas] = useState<RespostasPreConsulta>({});
+  const [enviada, setEnviada] = useState(false);
+  const [carregando, setCarregando] = useState(false);
+  const [erro, setErro] = useState('');
+
+  const chamar = async (action: string, extra: Record<string, unknown> = {}) => {
+    const { data, error } = await supabase.functions.invoke('patient-portal', {
+      body: { action, token, agendamento_id: agendamentoId, ...(dependenteId ? { dependente_id: dependenteId } : {}), ...extra },
+    });
+    if (error || data?.error) {
+      let texto = data?.error || 'Não foi possível concluir agora. Tente novamente.';
+      const context = (error as { context?: Response } | null)?.context;
+      if (context && typeof context.json === 'function') {
+        try { texto = (await context.json())?.error || texto; } catch { /* mantém a mensagem padrão */ }
+      }
+      throw new Error(texto);
+    }
+    return data;
+  };
+
+  const abrir = async () => {
+    setOpen(true);
+    setErro('');
+    setCarregando(true);
+    try {
+      const atual = await chamar('get_pre_consulta');
+      setRespostas(atual?.respostas ?? {});
+      setEnviada(!!atual);
+    } catch (e) {
+      setErro(friendlyErrorMessage(e, 'Não foi possível concluir a operação. Tente novamente.'));
+    } finally {
+      setCarregando(false);
+    }
+  };
+
+  const enviar = async () => {
+    setCarregando(true);
+    setErro('');
+    try {
+      await chamar('submit_pre_consulta', { respostas });
+      setEnviada(true);
+      setOpen(false);
+    } catch (e) {
+      setErro(friendlyErrorMessage(e, 'Não foi possível concluir a operação. Tente novamente.'));
+    } finally {
+      setCarregando(false);
+    }
+  };
+
+  return (
+    <>
+      <Button size="sm" variant="secondary" className="w-full text-xs" onClick={() => void abrir()}>
