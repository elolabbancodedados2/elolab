+        Perdi meu link de acesso
+      </button>
+    );
+  }
+
+  const submit = async () => {
+    setSending(true);
+    setMessage('');
+    setFailed(false);
+    const { data, error } = await supabase.functions.invoke('patient-portal', {
+      body: { action: 'solicitar_acesso', cpf, data_nascimento: nascimento },
+    });
+    setSending(false);
+    if (error || data?.error) {
+      let texto = data?.error || 'Não foi possível enviar agora. Tente novamente em instantes.';
+      const context = (error as { context?: Response } | null)?.context;
+      if (context && typeof context.json === 'function') {
+        try { texto = (await context.json())?.error || texto; } catch { /* mantém a mensagem padrão */ }
+      }
+      setFailed(true);
+      setMessage(texto);
