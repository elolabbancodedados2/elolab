+      <Button
+        className="w-full h-11"
+        variant="outline"
+        onClick={submit}
+        disabled={sending || cpf.replace(/\D/g, '').length !== 11 || !nascimento}
+      >
+        {sending ? 'Enviando…' : 'Enviar novo link'}
+      </Button>
+    </div>
+  );
+}
