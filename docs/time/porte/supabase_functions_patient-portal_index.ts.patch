+// Mesmas chaves de src/lib/preConsulta.ts.
+const CAMPOS_PRE_CONSULTA = ["queixa", "sintomas", "medicamentos", "alergias", "doencas", "cirurgias", "observacoes"] as const;
+
+/**
+ * Lista de médicos que a clínica liberou em Configurações → Agendamento online.
+ * `null` quando a clínica não restringiu (todos os ativos valem).
+ */
+async function medicosLiberadosOnline(supabase: any, clinicaId: string): Promise<string[] | null> {
+  const { data } = await supabase.from("configuracoes_clinica").select("valor")
+    .eq("clinica_id", clinicaId).eq("chave", "agendamento_online")
+    .order("updated_at", { ascending: false }).limit(1).maybeSingle();
+  const lista = (data?.valor as { medicos?: unknown } | null)?.medicos;
+  return Array.isArray(lista) && lista.length > 0 ? lista.map(String) : null;
+}
+
+const RESPOSTA_ACESSO = "Se os dados conferirem com um cadastro, enviamos um novo link de acesso para o e-mail e o WhatsApp cadastrados na clínica.";
+
+/**
+ * Recuperação de acesso sem token: CPF + data de nascimento identificam o
+ * paciente, mas o link só é entregue nos contatos já cadastrados. A resposta
+ * é sempre a mesma para não revelar se o CPF existe.
+ */
+async function solicitarAcesso(supabase: any, req: Request, body: any, corsHeaders: Record<string, string>) {
+  const json = (payload: unknown, status = 200) =>
+    new Response(JSON.stringify(payload), { status, headers: { ...corsHeaders, "Content-Type": "application/json" } });
+
+  const cpf = String(body.cpf ?? "").replace(/\D/g, "");
+  const nascimento = String(body.data_nascimento ?? "");
+  if (cpf.length !== 11 || !/^\d{4}-\d{2}-\d{2}$/.test(nascimento)) {
+    return json({ error: "Informe o CPF e a data de nascimento." }, 400);
+  }
+
+  const limitado =
+    await checarRateLimit(supabase, { chave: `portal-acesso:${clientIp(req)}`, limite: 5, janelaSegundos: 600 }) ||
+    await checarRateLimit(supabase, { chave: `portal-acesso-cpf:${cpf}`, limite: 3, janelaSegundos: 3600 });
+  if (limitado) return json({ error: "Muitas tentativas — aguarde alguns minutos." }, 429);
+
+  const { data: pacientes } = await supabase
+    .from("pacientes")
