+  security-e2e:
+    name: Segurança (Supabase local)
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    env:
+      QA_SUPABASE_DISPOSABLE: ELOLAB_LOCAL_DISPOSABLE
+      # Fase 2 (edge functions com stub): QA_EDGE_STUB_CONFIRMED e
+      # QA_WHATSAPP_STUB_CONFIRMED. Até lá esses testes pulam e estão na
+      # allowlist com prazo (scripts/ci/security-e2e-skips-permitidos.json).
+    steps:
+      - uses: actions/checkout@v6
+
+      # Antes de baixar imagens: com prefixo repetido o `supabase start` para
+      # na segunda migration (a CLI grava a versão com INSERT simples numa
+      # tabela com chave primária em `version`).
+      - name: Versões de migration únicas
+        run: |
+          dup=$(find supabase/migrations -maxdepth 1 -name '*.sql' -printf '%f\n' | cut -c1-14 | sort | uniq -d)
+          if [ -n "$dup" ]; then
+            echo "::error::Prefixo de migration repetido: $dup. Ver docs/arquitetura/banco/versoes-duplicadas.md"
